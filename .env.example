# Copy this file to .env and fill in your own values. Never commit .env.
# On Vercel / Render / Railway, add these in the host's Environment Variables screen instead.

# MongoDB connection string (MongoDB Atlas or local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority
# Optional: database name if your URI doesn't include one (default: portfolio)
MONGODB_DB_NAME=
# Optional, local only: DNS servers for mongodb+srv lookups (e.g. 1.1.1.1,8.8.8.8). If unset, the server
# automatically retries with public DNS when the OS resolver fails with "querySrv ECONNREFUSED".
MONGODB_DNS_SERVERS=

# Password for the admin dashboard at /admin. Leave blank to turn the dashboard off.
ADMIN_PASSWORD=
# Optional: long random string used to sign admin sessions (defaults to one derived from ADMIN_PASSWORD).
ADMIN_SECRET=
# Optional: static token for scripts/curl (Authorization: Bearer <ADMIN_TOKEN>).
ADMIN_TOKEN=

# Local server port (hosts like Render/Railway set this themselves; don't set it there)
PORT=3001

# Optional: OpenAI API key for the "Ask about my work" chat assistant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional: Formspree endpoint to also email contact messages (e.g. https://formspree.io/f/your-id)
FORMSPREE_ENDPOINT=

# Optional: allowed origins for CORS, comma-separated (default: allow all). Not needed when the
# site and API share one domain, which is the case on Vercel, Render and Railway.
CLIENT_ORIGIN=
